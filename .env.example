# Copy this file to .env and replace secrets with real values.
# Never commit .env itself.

# Neon PostgreSQL. Keep this as your Neon connection string; Compose does not
# start or replace a local database.
DATABASE_URL=postgresql+asyncpg://neon-user:replace-with-neon-password@your-neon-host/neondb?ssl=require

# Frontend browser URL for the backend API
VITE_API_BASE_URL=http://localhost:8000

# Security: generate unique values for any shared or production environment.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENV=development

# LLM. The placeholder provider works without an external API.
LLM_PROVIDER=placeholder
LLM_API_KEY=placeholder-local-key
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_MODEL=qwen2.5:7b-instruct
# Use http://ollama:11434 when starting the optional Compose Ollama profile.
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=1

# Embeddings and retrieval
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Upload and ingestion policy
MAX_FILE_SIZE_BYTES=10485760
MAX_INGESTION_RETRIES=3

# Optional S3-compatible storage. Leave blank to use backend/app/.local_storage.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=vault-bucket
AWS_REGION=us-east-1
