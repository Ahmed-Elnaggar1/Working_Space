# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vault_db
DB_USER=vault_user
DB_PASSWORD=vault_pass
DATABASE_URL=postgresql://vault_user:vault_pass@localhost:5432/vault_db

# Security
JWT_ACCESS_SECRET=please-change-this-to-a-secure-key-in-production
JWT_REFRESH_SECRET=please-change-this-to-a-secure-key-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Environment
ENV=development
